{
  "name": "movie-business",
  "version": "0.9.51",
  "description": "Movie Business -Die Welt der Filme",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:all": "node scripts/dev-all.js",
    "server": "node server/index.js",
    "server:tick": "node server/worldTick.js",
    "server:test:world-market": "node server/scripts/testWorldMarket.js",
    "server:test:release-charts": "node server/scripts/testReleaseAndCharts.js",
    "server:test:slots-phases": "node server/scripts/testSlotsAndPhases.js",
    "server:time": "node -e \"const t=require('./server/timeModel');console.log(JSON.stringify({monthIndex:t.getIngameMonthIndex(),ingameDate:t.getCurrentIngameDate().toISOString()},null,2));\"",
    "prepare:win-icon": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -ExecutionPolicy Bypass -File .\\scripts\\regenerate-windows-icon.ps1",
    "start": "npm run build && electron .",
    "dist": "npm run prepare:win-icon && npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "jszip": "^3.10.1",
    "file-saver": "^2.0.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.yourname.filmtycoon",
    "productName": "Movie Business",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg","zip"],
      "icon": "build/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Movie Business Setup.${ext}"
    }
  }
}